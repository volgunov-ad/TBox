{
  "formatVersion": 1,
  "automations": [
    {
      "id": "hu-test-hide-on-settings",
      "name": "HU test: Settings hide overlays",
      "description": "Foreground Settings -> hide floating panels",
      "enabled": true,
      "triggers": [
        {
          "type": "state_equals",
          "id": "1",
          "signal": "foreground_app",
          "source": "app",
          "expectedState": "com.android.settings",
          "holdMillis": 0,
          "startupBehavior": "initialize_only"
        }
      ],
      "conditions": [],
      "actions": [
        {
          "type": "builtin",
          "actionType": "show_toast",
          "intValue": 0,
          "stringValue": "HUTEST hide overlays (Settings)",
          "boolValue": false
        },
        {
          "type": "builtin",
          "actionType": "toggle_hide_floating_panels",
          "intValue": 0,
          "stringValue": "",
          "boolValue": false
        }
      ],
      "runMode": "restart",
      "maxRuns": 10,
      "conditionWaitMillis": 0
    },
