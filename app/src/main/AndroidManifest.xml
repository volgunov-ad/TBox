<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="vad.dashing.tbox">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Нужна для появления в «Выбор приложения для фиктивных местоположений»
         (Настройки разработчика). Выдаётся выбором приложения в Dev Options / AppOps. -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Без объявления приложение не попадает в список «Доступ к данным об использовании»;
         фактическое разрешение выдаётся только вручную в настройках (AppOps). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Виджет «Тема день/ночь»: A9 night_mode_auto / DAY_NIGHT_STATUS; A10+ auto_skin / adayo_skin.
         «Регулировка зеркал» на Android 9 (Settings.Global).
         Выдаётся вручную через adb: pm grant … android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- «Регулировка зеркал» на Android 10 (Settings.System mirrorAdjustment).
         На A10 pm grant обычно не срабатывает — включите «Изменение системных настроек» для приложения. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Для Android 10+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        android:minSdkVersion="29" />

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.car.permission.CAR_INFO"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_VENDOR_EXTENSION"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_SPEED"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_POWERTRAIN"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_ENGINE_DETAILED"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_ENERGY"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_ENERGY_PORTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_EXTERIOR_LIGHTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CABIN"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_AUDIO_VOLUME"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_AUDIO_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_CAR_CLIMATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_INTERIOR_LIGHTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_EXTERIOR_LIGHTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_DISPLAY_UNITS"
        tools:ignore="ProtectedPermissions" />

    <!-- Разрешения хранилища только для Android 9-10 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Для Android 11 (API 30) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"
        android:minSdkVersion="30" />

    <application
        android:name="vad.dashing.tbox.TboxApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TBox"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <meta-data
            android:name="android.app.default_searchable"
            android:value=".MainActivity" />

        <!-- Помогает части прошивок ГУ показать приложение в списке mock location. -->
        <meta-data
            android:name="mock_location"
            android:value="true" />

        <activity
            android:name="vad.dashing.tbox.MainActivityLaunchRouterActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.TBox.NoDisplay" />

        <activity
            android:name="vad.dashing.tbox.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.tboxtheme" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>

        <!-- Tiny freeform workspace anchor (Taskbar InvisibleActivityFreeform analogue). -->
        <activity
            android:name="vad.dashing.tbox.freeform.FreeformInvisibleAnchorActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <activity
            android:name="vad.dashing.tbox.WidgetPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- Share target: Yandex / 2GIS / geo: → CONSTANT shadow seed. Finishes immediately. -->
        <activity
            android:name="vad.dashing.tbox.location.GeoShareReceiverActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.geoshare"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="vad.dashing.tbox.BackgroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/esp_usb_device_filter" />
        </service>

        <service
            android:name="vad.dashing.tbox.MediaControlNotificationListenerService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name="vad.dashing.tbox.NetWidget"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="vad.dashing.tbox.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_net_info"/>
        </receiver>

        <receiver
            android:name="vad.dashing.tbox.ConWidget"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="vad.dashing.tbox.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_con_info"/>
        </receiver>

        <receiver
            android:name="vad.dashing.tbox.ConResWidget"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="vad.dashing.tbox.UPDATE_WIDGET" />
                <action android:name="vad.dashing.tbox.ACTION_TBOX_REBOOT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_con_res_info"/>
        </receiver>

        <receiver
            android:name="vad.dashing.tbox.BootCompleteReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="998">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="vad.dashing.tbox.DEBUG_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>