<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="vad.dashing.tbox">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation" /> -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Без объявления приложение не попадает в список «Доступ к данным об использовании»;
         фактическое разрешение выдаётся только вручную в настройках (AppOps). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Для Android 10+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        android:minSdkVersion="29" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.car.permission.CAR_INFO"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_VENDOR_EXTENSION"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_SPEED"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_POWERTRAIN"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_ENGINE_DETAILED"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_ENERGY"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_ENERGY_PORTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_EXTERIOR_LIGHTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CABIN"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_AUDIO_VOLUME"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_AUDIO_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_CAR_CLIMATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_INTERIOR_LIGHTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_EXTERIOR_LIGHTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.car.permission.CAR_CONTROL_DISPLAY_UNITS"
        tools:ignore="ProtectedPermissions" />

    <!-- Разрешения хранилища только для Android 9-10 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Для Android 11 (API 30) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"
        android:minSdkVersion="30" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.CAR_LAUNCHER" />
        </intent>
        <package android:name="com.wt.launcher3" />
        <provider android:authorities="com.wt.launcher3" />
    </queries>

    <application
        android:name="vad.dashing.tbox.TboxApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TBox"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:resizeableActivity="false"
        tools:targetApi="31">

        <meta-data
            android:name="android.app.default_searchable"
            android:value=".MainActivity" />

        <!-- <meta-data
            android:name="mock_location"
            android:value="true" /> -->

        <activity
            android:name="vad.dashing.tbox.LauncherHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.TBox.Launcher">
            <meta-data
                android:name="flagActivityFullScreen"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="vad.dashing.tbox.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape">
            <meta-data
                android:name="flagActivityFullScreen"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.tboxtheme" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>

        <activity
            android:name="vad.dashing.tbox.WidgetPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity
            android:name="vad.dashing.tbox.LauncherAppProxyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.TBox.Transparent" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="vad.dashing.tbox.BackgroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice">
        </service>

        <service
            android:name="vad.dashing.tbox.MediaControlNotificationListenerService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name="vad.dashing.tbox.NetWidget"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="vad.dashing.tbox.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_net_info"/>
        </receiver>

        <receiver
            android:name="vad.dashing.tbox.ConWidget"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="vad.dashing.tbox.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_con_info"/>
        </receiver>

        <receiver
            android:name="vad.dashing.tbox.ConResWidget"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="vad.dashing.tbox.UPDATE_WIDGET" />
                <action android:name="vad.dashing.tbox.ACTION_TBOX_REBOOT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_con_res_info"/>
        </receiver>

        <receiver
            android:name="vad.dashing.tbox.BootCompleteReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="998">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="vad.dashing.tbox.DEBUG_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>